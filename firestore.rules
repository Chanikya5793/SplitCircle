rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Hard device revocation (doc 31 §3.4 point 5) — a companion device's
    // Firebase Auth session carries a `deviceId` custom claim (minted by
    // pairing.ts's createCustomToken); the ORIGINAL/main device's session
    // does not (it signs in via email/Google/Apple, never a custom token),
    // so it always short-circuits true here. Once revokeDevice deletes a
    // companion's pairedDevices doc, this starts failing immediately for
    // that device's cached session, instead of waiting for its ID token to
    // naturally expire/refresh.
    //
    // Deliberately NOT folded into isSignedIn()/isSelf() themselves: this
    // function calls exists(), and this file's own isGroupMemberById fix
    // (see the comment on groups/{groupId}'s read rule) already documents
    // that Firestore denies LIST/collection-group queries outright the
    // moment ANY exists()/get() appears anywhere in an applicable rule,
    // regardless of what it's checking. isSignedIn()/isSelf() back list
    // queries all over this app (groups, chats, pairedDevices' own read
    // rule among them) — embedding this there would silently break every
    // one of them for companion-device sessions specifically, the exact
    // "shipped clean, broken in production" failure mode this codebase has
    // already been burned by once. Only apply this to rule branches
    // confirmed (by grepping the client) to be single-document reads/writes
    // ONLY, never a collection query — currently: users/{userId},
    // notificationDevices/{deviceId} (read), settings/{settingKey}.
    // Extending this to chats/messages/groups needs its own Firebase-
    // emulator-verified pass (no rules test harness exists in this repo
    // yet) — do not casually widen this without one.
    function hasLiveDeviceSession() {
      return !('deviceId' in request.auth.token)
        || exists(/databases/$(database)/documents/users/$(request.auth.uid)/pairedDevices/$(request.auth.token.deviceId));
    }

    function isSelfWithLiveDevice(userId) {
      return isSelf(userId) && hasLiveDeviceSession();
    }

    function groupExists(groupId) {
      return exists(/databases/$(database)/documents/groups/$(groupId));
    }

    function isGroupMemberById(groupId) {
      return isSignedIn()
        && groupExists(groupId)
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    function chatExists(chatId) {
      return exists(/databases/$(database)/documents/chats/$(chatId));
    }

    function isChatParticipantById(chatId) {
      return isSignedIn()
        && chatExists(chatId)
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
    }

    function isCurrentChatParticipant() {
      return isSignedIn() && request.auth.uid in resource.data.participantIds;
    }

    function isNewChatParticipant() {
      return isSignedIn() && request.auth.uid in request.resource.data.participantIds;
    }

    // A current member may remove only their own membership directly.
    // Owner and admin membership changes are server-authorized by the
    // mutateGroupMember callable.
    function isGroupDepartureUpdate(groupId) {
      return isGroupMemberById(groupId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'memberIds',
          'members',
          'archivedMembers',
          'updatedAt',
        ])
        && resource.data.memberIds.hasAll(request.resource.data.memberIds)
        && !(request.auth.uid in request.resource.data.memberIds)
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
        && request.resource.data.members.size() == resource.data.members.size() - 1;
    }

    function isGroupMutableUpdate(groupId) {
      return isGroupMemberById(groupId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'description',
          'photoURL',
          'moneyInChat',
          'budgets',
          'updatedAt',
        ])
        && request.resource.data.groupId == resource.data.groupId
        && request.resource.data.inviteCode == resource.data.inviteCode
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.memberIds == resource.data.memberIds
        && request.resource.data.members == resource.data.members
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function isChatMutableUpdate() {
      return isCurrentChatParticipant()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessage',
          'updatedAt',
          'groupId',
          'unreadCount',
          'pinnedMessages',
        ])
        && request.resource.data.chatId == resource.data.chatId
        && request.resource.data.type == resource.data.type
        && request.resource.data.participantIds == resource.data.participantIds
        && request.resource.data.participants == resource.data.participants;
    }

    match /users/{userId} {
      allow read, update, create: if isSelfWithLiveDevice(userId);
      allow delete: if false;
    }

    match /users/{userId}/blockedUsers/{blockedUserId} {
      allow read: if isSelf(userId);
      allow write: if false;
    }

    match /safetyReports/{reportId} {
      allow read, write: if false;
    }

    match /users/{userId}/notificationDevices/{deviceId} {
      allow read: if isSelfWithLiveDevice(userId);
      allow create, update, delete: if false;
    }

    // Cloud-Function-only (createPairingCode/redeemPairingCode/revokeDevice,
    // doc 31 §3.4) — same reasoning as notificationDevices above: the client
    // never writes this collection directly, so there is no per-field-shape
    // rule to maintain here as the pairing flow evolves.
    match /users/{userId}/pairedDevices/{deviceId} {
      allow read: if isSelf(userId);
      allow create, update, delete: if false;
    }

    // Signal prekey bundles (doc 31 §3.3) are deliberately readable by ANY
    // signed-in user, not just the owner: another participant's device needs
    // to fetch this bundle to establish an E2E session with this device —
    // this collection holds public key material only, by construction, never
    // a private key. Cloud-Function-only for now (redeemPairingCode writes
    // the initial bundle); Phase 3 may need to loosen create/update to allow
    // a device to rotate its OWN one-time prekeys directly once the
    // deviceId custom-auth-token claim (doc 31 §3.4 point 5) exists to scope
    // that safely — don't open this broadly without that claim in place.
    match /users/{userId}/signalPrekeys/{deviceId} {
      allow read: if isSignedIn();
      allow create, update, delete: if false;
    }

    // Backup recovery verifier (doc 31 §3.12). DENIED FOR READ AS WELL AS
    // WRITE, which is the whole point: this holds the SHA-256 the recovery
    // flow must present the preimage of, so a client that could read it back
    // would be able to replay the expected value and promote itself to main
    // with stolen credentials alone — collapsing §3.12's three factors
    // (SplitCircle auth + iCloud account access + passphrase) down to one.
    // Cloud Functions use the Admin SDK and bypass rules entirely, so
    // setBackupRecoveryVerifier/recoverAsNewMainDevice are unaffected.
    // `hasBackupRecovery` exists precisely so the UI can learn whether a
    // backup exists without this document ever reaching a client.
    match /users/{userId}/backupRecovery/{docId} {
      allow read, write: if false;
    }

    // Per-device-setting sync (doc 31 §3.8) — one flat doc per settings key
    // ({value, updatedAt}), never a nested map, so plain client writes are
    // safe without the merge:true/mergeFields gotcha ever coming into play.
    // Unlike the device-identity collections above, this is plain per-user
    // preference data (same trust model as the users/{userId} doc itself),
    // so it's client-writable directly rather than Cloud-Function-only.
    match /users/{userId}/settings/{settingKey} {
      allow read, write: if isSelfWithLiveDevice(userId);
    }

    // Security monitoring is callable-only. These documents contain encrypted
    // identity ciphertext, blind indexes, provider references, findings, scan
    // jobs, and audit events. Even the owner receives a deliberately projected
    // response rather than the stored document shape.
    match /securityMonitors/{userId} {
      allow read, write: if false;

      match /{document=**} {
        allow read, write: if false;
      }
    }

    // Provider deletion retries are server-owned tombstones. They contain no
    // plaintext identity, but exposing them would still leak provider usage.
    match /securityProviderDeletions/{deletionId} {
      allow read, write: if false;
    }

    // Tenant-wide provider identifiers can be shared by multiple monitored
    // identities. Reference counts are server-only so one user cannot detach
    // another user's provider enrollment or infer its existence.
    match /securityProviderIdentifierRefs/{referenceId} {
      allow read, write: if false;
    }

    match /groups/{groupId} {
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.expenses is list
        && request.resource.data.expenses.size() == 0
        && request.resource.data.settlements is list
        && request.resource.data.settlements.size() == 0;
      // Must use resource.data (not get()) so membership is provable for
      // collection queries like where('memberIds', 'array-contains', uid) —
      // get()-based rules deny list operations outright.
      allow read: if isSignedIn() && request.auth.uid in resource.data.memberIds;
      // Joining is intentionally absent here. The callable
      // joinGroupByInviteCode performs the invite-code lookup and membership
      // mutation with the Admin SDK. Allowing a client-side join update would
      // let any signed-in user who learns a group document ID bypass the code.
      allow update: if isGroupMutableUpdate(groupId) || isGroupDepartureUpdate(groupId);
      allow delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;
    }

    match /groups/{groupId}/expenses/{expenseId} {
      allow read: if isGroupMemberById(groupId);
      allow create, update, delete: if false;
    }

    match /chats/{chatId} {
      allow create: if isNewChatParticipant();
      allow read: if isCurrentChatParticipant();
      allow update: if isChatMutableUpdate();
      allow delete: if false;
    }

    match /chats/{chatId}/messages/{messageId} {
      allow read, create: if isChatParticipantById(chatId);
      allow update, delete: if false;
    }

    // Cross-device mutation sync (reactions, edits, delete-for-everyone).
    // Without this match the default deny blocks the messageState listener.
    match /chats/{chatId}/messageState/{messageId} {
      allow read, create, update: if isChatParticipantById(chatId);
      allow delete: if false;
    }

    match /expenses/{expenseId} {
      allow read: if isSignedIn()
        && resource.data.groupId is string
        && isGroupMemberById(resource.data.groupId);
      allow create, update, delete: if false;
    }

    match /recurringBills/{billId} {
      allow read: if isSignedIn()
        && resource.data.groupId is string
        && isGroupMemberById(resource.data.groupId);
      allow create, update, delete: if false;
    }

    match /calls/{callId} {
      allow create: if isSignedIn()
        && request.resource.data.chatId is string
        && isChatParticipantById(request.resource.data.chatId);
      allow read, update, delete: if isSignedIn()
        && resource.data.chatId is string
        && isChatParticipantById(resource.data.chatId);
    }
  }
}

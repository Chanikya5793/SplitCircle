# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
.env
google-services.json
GoogleService-Info.plist

# typescript
*.tsbuildinfo

# generated native folders
/ios/Build
/ios/Pods
/android

.tmp-build-logs
 
# Ignore generated root-level docs, except the maintained offline-first plan.
# (Nested docs/ like ai_layer/docs/ remain tracked.)
/docs/*
!/docs/OFFLINE_FIRST_RESEARCH.md
!/docs/2026-07-29_OFFLINE_MEDIA_SHARING_RESEARCH_AND_PLAN.md
!/docs/2026-07-29_NEARBY*.md


google-service-account.json

# Spike (fm-ios27) local Xcode-beta build output
ios/build-s0/

# EAS local build artifacts
*.ipa
build-output/
credentials/
SplitCircle*.ipa

# Gradle build output from RN/Expo native modules (they compile in place
# inside node_modules and modules/*). Never source; also what polluted a
# patch-package regeneration with 87KB of .bin artifacts.
modules/*/android/build/

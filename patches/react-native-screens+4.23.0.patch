+- (void)updateSearchResults:(UISearchController *)searchController
+{
+  [NSNotificationCenter.defaultCenter postNotificationName:RNSSearchTabTextDidChangeNotification
+                                                    object:nil
+                                                  userInfo:@{@"text" : searchController.searchBar.text ?: @""}];
+}
+
+- (void)willPresentSearchController:(UISearchController *)searchController
+{
+  [NSNotificationCenter.defaultCenter postNotificationName:RNSSearchTabDidActivateNotification object:nil userInfo:@{}];
+}
+
+- (void)willDismissSearchController:(UISearchController *)searchController
+{
+  [NSNotificationCenter.defaultCenter postNotificationName:RNSSearchTabDidDeactivateNotification
+                                                    object:nil
+                                                  userInfo:@{}];
+}
+
+- (void)searchBarSearchButtonClicked:(UISearchBar *)searchBar
+{
+  [NSNotificationCenter.defaultCenter postNotificationName:RNSSearchTabDidSubmitNotification
+                                                    object:nil
+                                                  userInfo:@{@"text" : searchBar.text ?: @""}];

+@implementation RNSSearchTabBridge
+
+- (instancetype)init
+{
+  if (self = [super init]) {
+    [NSNotificationCenter.defaultCenter addObserver:self
+                                           selector:@selector(rns_handleSetTextNotification:)
+                                               name:RNSSearchTabSetTextNotification
+                                             object:nil];
+  }
+  return self;
+}
+
+- (void)dealloc
+{
+  [NSNotificationCenter.defaultCenter removeObserver:self];
+}
+
+- (void)rns_handleSetTextNotification:(NSNotification *)notification
+{
+  UISearchController *searchController = self.searchController;
+  if (searchController == nil) {
+    return;
+  }
+  NSString *text = notification.userInfo[@"text"] ?: @"";
+  if (!searchController.isActive) {
+    searchController.active = YES;
+  }
+  searchController.searchBar.text = text;
+  // Setting text programmatically does not call the results updater — echo manually.
+  [self updateSearchResults:searchController];
+}

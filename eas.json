{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "image": "macos-tahoe-26.4-xcode-26.4"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium",
        "image": "macos-tahoe-26.4-xcode-26.4"
      }
    },
    "verification": {
      "distribution": "store",
      "android": {
        "buildType": "apk",
        "credentialsSource": "remote"
      }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "ios": {
        "resourceClass": "m-medium",
        "image": "macos-tahoe-26.4-xcode-26.4"
      },
      "android": {
        "buildType": "app-bundle",
        "credentialsSource": "remote"
      },
      "env": {
        "EXPO_PUBLIC_ENABLE_BLE_MESH": "1",
        "EXPO_PUBLIC_ENABLE_LAN_MESH": "1",
        "EXPO_PUBLIC_ENABLE_MESH_ROUTER": "1",
        "EXPO_PUBLIC_ENABLE_SYNC_BATCH": "1",
        "EXPO_PUBLIC_ENABLE_ORIGIN_RESEAL": "1"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal",
        "releaseStatus": "draft"
      },
      "ios": {
        "ascAppId": "6760814898"
      }
    }
  }
}

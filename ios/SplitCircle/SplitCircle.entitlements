<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>aps-environment</key>
    <string>production</string>
    <!-- Private Cloud Compute (doc 23): capability granted + added to the
         App ID / provisioning profile on the portal 2026-07-18. If signing
         rejects this key, the regenerated profile's Entitlements dict names
         the exact expected string — fix HERE, don't remove the capability. -->
    <key>com.apple.developer.private-cloud-compute</key>
    <true/>
    <!-- Sign in with Apple (doc 27): requires the capability enabled on the
         com.splitcircle.app App ID in the Apple Developer Portal BEFORE the
         next production build, or signing fails — same failure mode as PCC
         above. -->
    <key>com.apple.developer.applesignin</key>
    <array>
      <string>Default</string>
    </array>
    <!-- iCloud / CloudKit backup (doc 31 §3.2, Phase 4). Container
         `iCloud.com.splitcircle.app` ("SplitCircle Backup") was registered on
         the portal and assigned to the com.splitcircle.app App ID 2026-07-25 —
         BEFORE this key was committed, per the same rule the App Group note
         below states. Verified after saving: iCloud enabled, "Include CloudKit
         support" on, Enabled iCloud Containers (1). Prior to that the App ID
         had iCloud ticked but ZERO containers, which is why the provisioning
         profile carried `icloud-container-identifiers` as an EMPTY array and
         every CloudKit call would have failed at runtime.
         If signing ever rejects these keys, check the container is still
         assigned on the portal — don't delete the keys. -->
    <key>com.apple.developer.icloud-container-identifiers</key>
    <array>
      <string>iCloud.com.splitcircle.app</string>
    </array>
    <key>com.apple.developer.icloud-services</key>
    <array>
      <string>CloudKit</string>
    </array>
    <!-- NOTE: the App Group capability
           com.apple.security.application-groups → group.com.splitcircle.app
         is added here as part of the one-time widget setup (ai_layer/docs/19 runbook),
         NOT before: the moment this key is committed, the next production build
         requires that capability provisioned on the com.splitcircle.app App ID or
         signing fails. Until the widget target + portal capability exist, the widget
         snapshot write no-ops and Siri intents fall back to the SQLite index. -->
  </dict>
</plist>

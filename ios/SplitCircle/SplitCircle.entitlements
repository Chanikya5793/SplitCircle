<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>aps-environment</key>
    <string>production</string>
    <!-- Private Cloud Compute (doc 23): capability granted + added to the
         App ID / provisioning profile on the portal 2026-07-18. If signing
         rejects this key, the regenerated profile's Entitlements dict names
         the exact expected string — fix HERE, don't remove the capability. -->
    <key>com.apple.developer.private-cloud-compute</key>
    <true/>
    <!-- Sign in with Apple (doc 27): requires the capability enabled on the
         com.splitcircle.app App ID in the Apple Developer Portal BEFORE the
         next production build, or signing fails — same failure mode as PCC
         above. -->
    <key>com.apple.developer.applesignin</key>
    <array>
      <string>Default</string>
    </array>
    <!-- iCloud / CloudKit backup (doc 31 §3.2, Phase 4). Container
         `iCloud.com.splitcircle.app` ("SplitCircle Backup") was registered on
         the portal and assigned to the com.splitcircle.app App ID 2026-07-25 —
         BEFORE this key was committed, per the same rule the App Group note
         below states. Verified after saving: iCloud enabled, "Include CloudKit
         support" on, Enabled iCloud Containers (1). Prior to that the App ID
         had iCloud ticked but ZERO containers, which is why the provisioning
         profile carried `icloud-container-identifiers` as an EMPTY array and
         every CloudKit call would have failed at runtime.
         If signing ever rejects these keys, check the container is still
         assigned on the portal — don't delete the keys. -->
    <key>com.apple.developer.icloud-container-identifiers</key>
    <array>
      <string>iCloud.com.splitcircle.ManaSplit</string>
    </array>
    <key>com.apple.developer.icloud-services</key>
    <array>
      <string>CloudKit</string>
    </array>
    <!-- App Group (doc 36 §4 / doc 19 runbook). The capability was provisioned
         on the com.splitcircle.app App ID 2026-08-03 and the group assigned,
         BEFORE this key was committed — the same ordering rule the iCloud note
         above states, and the reason it is safe now when it was not before.
         Verified on the portal: "Enabled App Groups (1)".

         Serves two things: the Notification Service Extension's shared
         container and keychain access group (it doubles as a keychain access
         group, which is why no separate Keychain Sharing capability is needed),
         and the still-unbuilt widget target.

         If signing ever rejects this key, check the group is still assigned on
         the App ID — do not delete the key. -->
    <key>com.apple.security.application-groups</key>
    <array>
      <string>group.com.splitcircle.app</string>
    </array>
    <!-- Lets the app and the NSE share the Signal identity key. An app group
         identifier is valid here precisely because both targets carry the
         entitlement above. -->
    <key>keychain-access-groups</key>
    <array>
      <string>group.com.splitcircle.app</string>
    </array>
  </dict>
</plist>
